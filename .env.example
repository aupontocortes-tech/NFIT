NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
NEXT_PUBLIC_USE_MOCK=false

# ── IA para "Gerar com IA" (preencha só UMA, ou escolha com AI_PROVIDER) ──
# AI_PROVIDER=openai   # openai | xai | gemini | groq | ollama

# OpenAI — pago por uso: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# xAI Grok — pago por uso: https://console.x.ai
XAI_API_KEY=
# XAI_MODEL=grok-4.7

# Google Gemini — chave grátis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq — chave grátis: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — IA rodando no seu PC, sem chave (https://ollama.com)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
